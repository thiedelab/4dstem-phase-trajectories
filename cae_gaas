## Directional flux through hybrid states

unique_phases = sorted(set(phase_all) | set(phase_all))
phase_to_id = {p: i for i, p in enumerate(unique_phases)}
phase_id_all = np.array([phase_to_id[p] for p in phase_all])

nP = len(unique_phases)
C_phase = np.zeros((nP, nP), dtype=int)

# counts in phase space
traj_phase = defaultdict(list)
for i in range(len(phase_id_all)):
    y, x = xy_sorted[i]
    T = temps_sorted[i]
    pid = phase_id_all[i]
    traj_phase[(y, x)].append((T, pid))

for key in traj_phase:
    traj_phase[key] = sorted(traj_phase[key], key=lambda x: x[0])

for key, seq in traj_phase.items():
    for (_, p1), (_, p2) in zip(seq[:-1], seq[1:]):
        C_phase[p1, p2] += 1

row_sums = np.maximum(C_phase.sum(axis=1, keepdims=True), 1)
P_phase = C_phase / row_sums

# stationary distribution as normalized visit counts
visit_counts = C_phase.sum(axis=1) + C_phase.sum(axis=0)
pi_phase = visit_counts / visit_counts.sum()

# Compute net flux J_{i->j}
J = np.zeros_like(P_phase, dtype=float)
for i in range(nP):
    for j in range(nP):
        J[i, j] = pi_phase[i] * P_phase[i, j] - pi_phase[j] * P_phase[j, i]

# Focus on fluxes involving hybrid phases?
