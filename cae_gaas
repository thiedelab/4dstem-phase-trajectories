def compute_transition_matrix(traj, Tmin, Tmax, n_phases):
    C = np.zeros((n_phases, n_phases), dtype=int)

    for key, seq in traj.items():
        # iterate over consecutive pairs
        for (T1, p1), (T2, p2) in zip(seq[:-1], seq[1:]):
            # include only transitions fully inside the range
            if Tmin <= T1 <= Tmax and Tmin <= T2 <= Tmax:
                C[p1, p2] += 1

    # normalize rows
    row_sums = C.sum(axis=1, keepdims=True)
    P = C / np.maximum(row_sums, 1)
    return C, P


