import numpy as np
from sklearn.cluster import KMeans

def gpcca(P, n_macrostates=15):
    # 1. Compute eigenvalues & eigenvectors
    evals, evecs = np.linalg.eig(P.T)

    # 2. Sort by eigenvalue magnitude (descending)
    idx = np.argsort(-np.abs(evals))
    evals = evals[idx]
    evecs = evecs[:, idx]

    # 3. Keep the first k slow modes
    #    (exclude the stationary eigenvector if desired)
    k = n_macrostates
    slow_modes = np.real(evecs[:, :k])   # shape (n_micro, k)

    # 4. Cluster microstates in slow-mode space
    km = KMeans(n_clusters=n_macrostates, random_state=0)
    macro_assignments = km.fit_predict(slow_modes)

    return macro_assignments


