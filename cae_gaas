    i = phase_to_id[h]
    print(f"\nNet flux involving hybrid phase {h}:")
    for j, p_j in enumerate(unique_phases):
        if i == j:
            continue
        if abs(J[i, j]) < 1e-4:
            continue
        direction = "→" if J[i, j] > 0 else "←"
        print(f"{h} {direction} {p_j}: J = {J[i, j]:.4f}")


