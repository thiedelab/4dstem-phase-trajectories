h5_path = "aligned_patterns.h5"

patterns_list = []
xy_list = []
temp_list = []

with h5py.File(h5_path, "r") as f:
    temp_keys = sorted([k for k in f.keys() if k.startswith("T")],
                       key=lambda s: int(s[1:]))  # "T0","T1",...

    for T_key in temp_keys:
        dp = f[T_key]["patterns"]          # (Ny, Nx, H, W)
        Ny, Nx = dp.shape[:2]
        T_idx = int(T_key[1:])             # numeric temp index (or use real temp if stored)

        for y in range(Ny):
            for x in range(Nx):
                patterns_list.append(dp[y, x])
                xy_list.append((y, x))
                temp_list.append(T_idx)

patterns = np.stack(patterns_list, axis=0).astype(np.float32)  # (N, H, W)
xy = np.array(xy_list, dtype=np.int32)                         # (N, 2)
temps = np.array(temp_list, dtype=np.int32)                    # (N,)
ids = np.arange(len(patterns), dtype=np.int64)                 # global stable ID


