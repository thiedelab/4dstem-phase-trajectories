from skimage.transform import warp_polar
import numpy as np

def polar_transform(im, radius=None, output_shape=None):
    if radius is None:
        radius = min(im.shape)//2
    if output_shape is None:
        output_shape = (360, radius)
    polar = warp_polar(
        im,
        radius=radius,
        output_shape=output_shape,
        scaling='linear'
    )
    return polar  # (angles, radii)

def crop_radial_range(polar_im, r_min, r_max):
    """
    polar_im: (angles, radii)
    r_min, r_max: integer indices in radial axis
    """
    return polar_im[:, r_min:r_max]


# In[59]:


def compute_ccf(polar_im):
    F = np.fft.fft(polar_im, axis=0)
    power = np.abs(F)**2
    ccf = np.real(np.fft.ifft(power, axis=0))

    norm = np.sum(polar_im, axis=0)**2
    mask = norm > 0
    ccf[:, mask] /= norm[mask]
    ccf[:, mask] -= 1
    return ccf

def extract_symmetry(ccf, max_sym=12):
    F = np.fft.fft(ccf, axis=0)
    sym = np.abs(F[:max_sym+1])
    return sym


def compute_symmetry_for_pattern(pattern, max_sym=12, r_min=18, r_max=35):
    polar = polar_transform(pattern)
    polar_crop = crop_radial_range(polar, r_min, r_max)
    ccf = compute_ccf(polar_crop)
    sym = extract_symmetry(ccf, max_sym=max_sym)
    return sym  # (max_sym+1, r_max - r_min)



