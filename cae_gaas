def show_reconstructions(model, fixed_batch, epoch):
    model.eval()
    with torch.no_grad():
        recon, _ = model(fixed_batch)

    fig, axes = plt.subplots(2, 6, figsize=(15, 5))

    for i in range(6):
        axes[0, i].imshow(fixed_batch[i].cpu().squeeze(), cmap="viridis")
        axes[0, i].set_title(f"Original {fixed_ids[i]}")
        axes[0, i].axis("off")

        axes[1, i].imshow(recon[i].cpu().squeeze(), cmap="viridis")
        axes[1, i].set_title(f"Recon @ epoch {epoch}")
        axes[1, i].axis("off")

    plt.tight_layout()
    plt.show()
#######


# criterion = nn.MSELoss()
criterion = nn.L1Loss()
optimizer = optim.Adam(model.parameters(), lr=1e-3)
scheduler = torch.optim.lr_scheduler.StepLR(optimizer, step_size=10, gamma=0.5)

num_epochs = 100
epoch_losses = []

check_epochs = {1, 2, 5, 10, 25, 50, 100}

for epoch in range(1, num_epochs + 1):
    model.train()
    running_loss = 0.0

    for batch in dataloader:
        x = batch["pattern"].to(device)
        optimizer.zero_grad()
        x_recon, _ = model(x)
        loss = criterion(x_recon, x)
        loss.backward()
        optimizer.step()
        running_loss += loss.item() * x.size(0)

    scheduler.step()
    epoch_loss = running_loss / len(dataset)
    epoch_losses.append(epoch_loss)
    print(f"Epoch {epoch}/{num_epochs}, Loss: {epoch_loss:.6f}, LR: {scheduler.get_last_lr()[0]:.3e}")

    if epoch in check_epochs:
        show_reconstructions(model, fixed_batch, epoch)


