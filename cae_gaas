from scipy.ndimage import shift
import torch
from torch.utils.data import Dataset

def mask_central_beam(img, qx0, qy0, radius):
    H, W = img.shape
    Y, X = np.ogrid[:H, :W]
    mask = (X - qx0)**2 + (Y - qy0)**2 <= radius**2
    out = img.copy()
    out[mask] = 0
    return out

def mask_outer_circle(img, cx, cy, radius):
    H, W = img.shape
    Y, X = np.ogrid[:H, :W]
    mask = (X - cx)**2 + (Y - cy)**2 >= radius**2
    out = img.copy()
    out[mask] = 0
    return out

class STEM4DDataset(Dataset):
    def __init__(
        self,
        patterns,
        xy,
        temps,
        ids,
        probe_qx0,
        probe_qy0,
        central_radius=12,
        outer_radius=None,
        transform=None,
    ):
        self.N, self.H, self.W = patterns.shape

        # broadcast probe centers if scalar
        if np.isscalar(probe_qx0):
            probe_qx0 = np.full(self.N, probe_qx0, dtype=np.float32)
        if np.isscalar(probe_qy0):
            probe_qy0 = np.full(self.N, probe_qy0, dtype=np.float32)

        self.probe_qx0 = probe_qx0
        self.probe_qy0 = probe_qy0

        centered_patterns = []
        for i in range(self.N):
            img = patterns[i]

            img = mask_central_beam(img, probe_qx0[i], probe_qy0[i], central_radius)

            dx = self.W / 2 - probe_qx0[i]
            dy = self.H / 2 - probe_qy0[i]
            img = shift(img, shift=(dy, dx), mode="nearest")

            if outer_radius is not None:
                img = mask_outer_circle(img, self.W / 2, self.H / 2, outer_radius)

            p99 = np.percentile(img, 99)
            if p99 > 1e-6:
                img = img / p99
            img = np.clip(img, 0, 1)

            centered_patterns.append(img.astype(np.float32))

        self.patterns = np.stack(centered_patterns, axis=0)
        self.xy = xy.astype(np.int32)
        self.temps = temps.astype(np.int32)
        self.ids = ids.astype(np.int64)
        self.transform = transform

    def __len__(self):
        return self.N

    def __getitem__(self, idx):
        img = torch.from_numpy(self.patterns[idx]).unsqueeze(0)  # (1,H,W)

        if self.transform:
            img = self.transform(img)

        sample = {
            "pattern": img,
            "xy": torch.from_numpy(self.xy[idx]),   # (2,)
            "temp": torch.tensor(self.temps[idx]),
            "id": torch.tensor(self.ids[idx]),
        }
        return sample


