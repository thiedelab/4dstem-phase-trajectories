def patterns_for_pixel(y, x, xy_sorted, temps_sorted, all_originals_sorted):
    mask = (xy_sorted[:, 0] == y) & (xy_sorted[:, 1] == x)
    idxs = np.where(mask)[0]

    # sort by temperature
    order = np.argsort(temps_sorted[idxs])
    idxs = idxs[order]

    patterns_px = all_originals_sorted[idxs, 0]   # (n_temps, H, W)
    temps_px = temps_sorted[idxs]

    return temps_px, patterns_px

